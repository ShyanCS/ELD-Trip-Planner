# ─── ELD Trip Planner — Environment Variables ─────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# Usage: cp .env.example backend/.env

# Django core
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouteService geocoding/routing API
# Free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-ors-api-key-here

# CORS — comma-separated allowed origins (production only; ignored when DEBUG=True)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (optional — defaults to SQLite for local dev)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
